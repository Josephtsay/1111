# 複製為 .env 後填入實際值：cp .env.example .env
# .env 已列入 .gitignore，不會被提交

# === AWS ===
AWS_REGION=us-east-1
# 若用 named profile 就填，否則留空走預設 credential chain
AWS_PROFILE=

# === Bedrock ===
# Cohere Embed v4，1536 dim，~128k token context
# 注意：base model ID (cohere.embed-v4:0) 的 inference type 是 INFERENCE_PROFILE，
# 不能直接 invoke，必須用 cross-region inference profile ID（us. 或 global. 前綴）。
# 用 scripts/list_bedrock_models.py profiles 確認你的 region 有哪些。
BEDROCK_EMBED_MODEL_ID=us.cohere.embed-v4:0
EMBED_DIM=1536
# 單次請求最多幾筆 text（Cohere 系列上限為 96）
EMBED_BATCH_SIZE=96

# Task 4 摘要用 model（由並行 agent 使用，見 SUMMARIZE_PROMPT.md）
# 用 scripts/list_bedrock_models.py profiles 確認實際可用的 ID
SUMMARIZE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
SUMMARIZE_CONCURRENCY=8

# === OpenSearch ===
# 例：https://search-xxx.us-east-1.es.amazonaws.com 或 https://localhost:9200
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=jobs_v1
# 認證方式：aws_iam | basic | none
OPENSEARCH_AUTH=aws_iam
# OPENSEARCH_AUTH=basic 時才需要
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Amazon OpenSearch Service 用 es，Serverless 用 aoss
OPENSEARCH_SERVICE=es
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_BULK_BATCH_SIZE=500
